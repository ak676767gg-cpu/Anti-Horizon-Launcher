{
  "identifier": "default",
  "description": "The launcher window: its own commands, progress events, and its own title bar (drag, minimise, maximise, close).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
