{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anti-Horizon Launcher",
  "mainBinaryName": "Anti-Horizon Launcher",
  "version": "0.2.13",
  "identifier": "com.antihorizon.launcher",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Anti Horizon Launcher",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#070e15"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' blob:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "AK",
    "copyright": "© 2026 AK",
    "category": "Game",
    "shortDescription": "Anti-Horizon Launcher",
    "longDescription": "A fast Minecraft: Java Edition launcher in Anti-Horizon's gold and space.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/head.bmp",
        "sidebarImage": "installer/side.bmp",
        "startMenuFolder": "Anti-Horizon",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1OTlENTlCOTk1ODk0NjMKUldSamxGaVptOVdaSmI3QVNSdy8xd1lnZmZ5Rk4reXRMb21vKzlXYlEycm03YU9HUDBxMWFQbDAK",
      "endpoints": [
        "https://anti-horizon.com/launcher/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
